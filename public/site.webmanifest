{
  "id": "/",
  "name": "Brisk Budget",
  "short_name": "Brisk Budget",
  "description": "A lightweight, self-hosted personal finance tracker: your accounts, recurring payments and forecasts, with your data kept on your own server.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#0c2733",
  "background_color": "#0b2430",
  "categories": ["finance"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add transaction",
      "short_name": "Add",
      "description": "Add a transaction to one of your accounts",
      "url": "/?action=add",
      "icons": [{ "src": "/icons/shortcut-add.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Recurring payments",
      "short_name": "Recurring",
      "description": "See what's due and log your regular payments",
      "url": "/#/recurring",
      "icons": [{ "src": "/icons/shortcut-recurring.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/phone-dashboard.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "The dashboard on a phone: net worth, cash, savings and debt at a glance"
    },
    {
      "src": "/screenshots/phone-account.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "An account on a phone: its balance and how this month is going"
    },
    {
      "src": "/screenshots/desktop-dashboard.webp",
      "sizes": "1440x900",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "The dashboard on a computer: balances over time, forecasts and where money goes"
    }
  ]
}
