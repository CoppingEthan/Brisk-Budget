{
  "name": "brisk-budget",
  "version": "0.4.0",
  "description": "Brisk Budget - A lightweight, self-hosted personal finance tracker",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js --dev",
    "test": "node --test --test-reporter=spec",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "keywords": [
    "personal-finance",
    "budget",
    "budgeting",
    "finance-tracker",
    "money-management",
    "expense-tracker",
    "self-hosted",
    "household-budget",
    "pwa"
  ],
  "author": "Ethan Copping",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CoppingEthan/Brisk-Budget.git"
  },
  "homepage": "https://briskbudget.app",
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
